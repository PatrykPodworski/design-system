{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "design-system",
  "homepage": "https://github.com/PatrykPodworski/design-system",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Theme",
      "description": "Color, radius and font tokens of the design system.",
      "dependencies": [
        "shadcn",
        "tw-animate-css"
      ],
      "registryDependencies": [
        "PatrykPodworski/design-system/font-inter",
        "PatrykPodworski/design-system/font-cutive"
      ],
      "cssVars": {
        "theme": {
          "font-heading": "var(--font-sans)",
          "color-overlay": "var(--overlay)",
          "radius-sm": "calc(var(--radius) * 0.6)",
          "radius-md": "calc(var(--radius) * 0.8)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) * 1.4)",
          "radius-2xl": "calc(var(--radius) * 1.8)",
          "radius-3xl": "calc(var(--radius) * 2.2)",
          "radius-4xl": "calc(var(--radius) * 2.6)"
        },
        "light": {
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.148 0.004 228.8)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.148 0.004 228.8)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.148 0.004 228.8)",
          "primary": "oklch(0.852 0.199 91.936)",
          "primary-foreground": "oklch(0.421 0.095 57.708)",
          "secondary": "oklch(0.967 0.001 286.375)",
          "secondary-foreground": "oklch(0.21 0.006 285.885)",
          "muted": "oklch(0.963 0.002 197.1)",
          "muted-foreground": "oklch(0.56 0.021 213.5)",
          "accent": "oklch(0.963 0.002 197.1)",
          "accent-foreground": "oklch(0.218 0.008 223.9)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.925 0.005 214.3)",
          "input": "oklch(0.925 0.005 214.3)",
          "ring": "oklch(0.723 0.014 214.4)",
          "chart-1": "oklch(0.905 0.182 98.111)",
          "chart-2": "oklch(0.795 0.184 86.047)",
          "chart-3": "oklch(0.681 0.162 75.834)",
          "chart-4": "oklch(0.554 0.135 66.442)",
          "chart-5": "oklch(0.476 0.114 61.907)",
          "radius": "0.875rem",
          "sidebar": "oklch(0.987 0.002 197.1)",
          "sidebar-foreground": "oklch(0.148 0.004 228.8)",
          "sidebar-primary": "oklch(0.681 0.162 75.834)",
          "sidebar-primary-foreground": "oklch(0.987 0.026 102.212)",
          "sidebar-accent": "oklch(0.963 0.002 197.1)",
          "sidebar-accent-foreground": "oklch(0.218 0.008 223.9)",
          "sidebar-border": "oklch(0.925 0.005 214.3)",
          "sidebar-ring": "oklch(0.723 0.014 214.4)",
          "overlay": "oklch(0 0 0 / 80%)"
        },
        "dark": {
          "background": "oklch(0.148 0.004 228.8)",
          "foreground": "oklch(0.987 0.002 197.1)",
          "card": "oklch(0.218 0.008 223.9)",
          "card-foreground": "oklch(0.987 0.002 197.1)",
          "popover": "oklch(0.218 0.008 223.9)",
          "popover-foreground": "oklch(0.987 0.002 197.1)",
          "primary": "oklch(0.795 0.184 86.047)",
          "primary-foreground": "oklch(0.421 0.095 57.708)",
          "secondary": "oklch(0.274 0.006 286.033)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.275 0.011 216.9)",
          "muted-foreground": "oklch(0.723 0.014 214.4)",
          "accent": "oklch(0.275 0.011 216.9)",
          "accent-foreground": "oklch(0.987 0.002 197.1)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.56 0.021 213.5)",
          "chart-1": "oklch(0.905 0.182 98.111)",
          "chart-2": "oklch(0.795 0.184 86.047)",
          "chart-3": "oklch(0.681 0.162 75.834)",
          "chart-4": "oklch(0.554 0.135 66.442)",
          "chart-5": "oklch(0.476 0.114 61.907)",
          "sidebar": "oklch(0.218 0.008 223.9)",
          "sidebar-foreground": "oklch(0.987 0.002 197.1)",
          "sidebar-primary": "oklch(0.795 0.184 86.047)",
          "sidebar-primary-foreground": "oklch(0.987 0.026 102.212)",
          "sidebar-accent": "oklch(0.275 0.011 216.9)",
          "sidebar-accent-foreground": "oklch(0.987 0.002 197.1)",
          "sidebar-border": "oklch(1 0 0 / 10%)",
          "sidebar-ring": "oklch(0.56 0.021 213.5)",
          "overlay": "oklch(0 0 0 / 80%)"
        }
      },
      "css": {
        "@import \"tw-animate-css\"": {},
        "@import \"shadcn/tailwind.css\"": {}
      }
    },
    {
      "name": "font-inter",
      "type": "registry:font",
      "title": "Inter",
      "description": "Inter as the sans-serif font.",
      "font": {
        "family": "'Inter Variable', sans-serif",
        "provider": "google",
        "import": "Inter",
        "variable": "--font-sans",
        "subsets": [
          "latin"
        ],
        "dependency": "@fontsource-variable/inter"
      }
    },
    {
      "name": "font-cutive",
      "type": "registry:font",
      "title": "Cutive",
      "description": "Cutive as the serif font for display text.",
      "font": {
        "family": "'Cutive', serif",
        "provider": "google",
        "import": "Cutive",
        "variable": "--font-serif",
        "weight": [
          "400"
        ],
        "subsets": [
          "latin"
        ],
        "dependency": "@fontsource/cutive",
        "selector": ""
      }
    },
    {
      "name": "design-doc",
      "type": "registry:file",
      "title": "Design rules",
      "description": "DESIGN.md: the rules for building UI with this design system.",
      "files": [
        {
          "path": "DESIGN.md",
          "type": "registry:file",
          "target": "~/DESIGN.md"
        }
      ]
    },
    {
      "name": "design-rules",
      "type": "registry:file",
      "title": "Agent rules",
      "description": "A Claude Code rule (.claude/rules/design-system.md) that points agents to DESIGN.md, which it installs too.",
      "registryDependencies": [
        "PatrykPodworski/design-system/design-doc"
      ],
      "files": [
        {
          "path": "registry/rules/design-system.md",
          "type": "registry:file",
          "target": "~/.claude/rules/design-system.md"
        }
      ]
    },
    {
      "name": "starter",
      "type": "registry:item",
      "title": "Starter",
      "description": "The theme, DESIGN.md and the agent rule in one install. Add components separately.",
      "registryDependencies": [
        "PatrykPodworski/design-system/theme",
        "PatrykPodworski/design-system/design-rules"
      ]
    },
